{
	admin off
	auto_https off
}

# The Brev public HTTPS endpoint terminates TLS and sends HTTP to this port.
:8040 {
	header Referrer-Policy "same-origin"
	header Strict-Transport-Security "max-age=86400"
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:4178 {
		header_up Host {$LOCKEY_PUBLIC_HOST}
	}
}
